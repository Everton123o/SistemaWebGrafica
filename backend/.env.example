# Configure local credentials; never commit .env.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/grafica
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Required when VITE_API_URL points directly to the API tunnel. JSON array.
# CORS_ORIGINS=["https://your-frontend-tunnel.ngrok-free.app"]
